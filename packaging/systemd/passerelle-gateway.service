[Unit]
Description=Passerelle gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=passerelle
Group=passerelle
ExecStart=/usr/local/bin/passerelle-gateway run --config /etc/passerelle/gateway.toml
Restart=on-failure
RestartSec=2
AmbientCapabilities=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
